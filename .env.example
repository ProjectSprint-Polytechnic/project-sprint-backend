# Скопируйте в .env и поменяйте значения
FLASK_APP=wsgi.py
DATABASE_URL=postgresql+psycopg://politech:politech@localhost:5432/politech
TEST_DATABASE_URL=postgresql+psycopg://politech:politech@localhost:5432/politech_test
SECRET_KEY=поменяйте-на-длинную-случайную-строку
JWT_SECRET_KEY=и-эту-тоже
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20
APP_TIMEZONE=Europe/Moscow
